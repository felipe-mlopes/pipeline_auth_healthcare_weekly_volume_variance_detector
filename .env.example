# ------------ Fonte (Athena) --------------
RADAR_ATHENA_S3_STAGING_DIR=s3://meu-bucket/athena-results/
RADAR_ATHENA_REGION=us-east-1
RADAR_ATHENA_WORK_GROUP=primary

# ----------- Cache de snapshots -----------
RADAR_DIRETORIO_DADOS=./data
RADAR_RETENCAO_SNAPSHOTS=52

# ----------- Cron Job ---------------------
RADAR_CRON=0 11 * * mon # toda segunda às 11:00
RADAR_TIMEZONE=America/Sao_Paulo
RADAR_TENTATIVAS=3